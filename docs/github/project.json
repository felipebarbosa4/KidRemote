      "type": "SINGLE_SELECT",
      "options": [
        "Low",
        "Medium",
        "High"
      ]
    },
    {
      "name": "Area",
      "type": "SINGLE_SELECT",
      "options": [
        "Product",
        "Parent",
        "Child Android",
        "Backend",
        "Sync",
        "Security",
        "Policy",
        "Design",
        "QA",
        "Infra"
      ]
    },
    {
      "name": "Platform",
      "type": "SINGLE_SELECT",
      "options": [
        "Shared",
        "Android",
        "Backend",
        "Fire OS",
        "iOS",
        "Windows"
      ]
    },
    {
      "name": "Decision Required",
      "type": "SINGLE_SELECT",
      "options": [
        "Yes",
        "No"
      ]
    },
    {
      "name": "Work Type",
      "type": "SINGLE_SELECT",
      "options": [
        "Specification",
        "Spike",
        "Implementation"
      ]
    },
    {
      "name": "Start Date",
      "type": "DATE"
    },
    {
      "name": "Target Date",
      "type": "DATE"
    }
  ],
  "views": [
    {
      "name": "Backlog",
      "layout": "TABLE",
      "sort": {
        "field": "Priority",
        "direction": "ASC"
      },
      "filter": {
        "status_not": "Done"
      }
    },
    {
      "name": "Current Sprint",
      "layout": "BOARD",
      "group_by": "Status",
      "query": "iteration:@current"
    },
    {
      "name": "Architecture",
      "layout": "TABLE",
      "filter": {
        "work_type_any": [
          "Specification",
          "Spike"
        ]
      },
      "sort": {
        "field": "Priority",
        "direction": "ASC"
      }
    },
    {
      "name": "Security & Policy",
      "layout": "TABLE",
      "filter": {
        "labels_any": [
          "security",
          "privacy",
          "policy"
        ]
      },
      "sort": {
        "field": "Priority",
        "direction": "ASC"
      }
    },
    {
      "name": "Roadmap",
      "layout": "ROADMAP",
      "group_by": "Platform",
      "date_fields": [
        "Start Date",
        "Target Date"
      ],
      "platform_order": [
        "Shared",
        "Android",
        "Backend",
        "Fire OS",
        "iOS",
        "Windows"
      ],
      "dates": "UNSPECIFIED"
    }
  ],
