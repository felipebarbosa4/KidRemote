        "Backlog",
        "Ready",
        "In Progress",
        "In Review",
        "Blocked",
        "Done"
      ],
      "builtin": true
    },
    {
      "name": "Priority",
      "type": "SINGLE_SELECT",
      "options": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    {
      "name": "Story Points",
      "type": "NUMBER",
      "recommended_values": [
        1,
        2,
        3,
        5,
        8,
        13
      ]
    },
    {
      "name": "Iteration",
      "type": "ITERATION",
      "duration_days": 7,
      "start": "UNSPECIFIED"
    },
    {
